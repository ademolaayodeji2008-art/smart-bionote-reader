# This project uses two separate .env files — copy each template below.
#
#   frontend/.env.example -> frontend/.env
#   backend/.env.example  -> backend/.env
#
# The variables are duplicated here purely for a quick project-wide overview.

# ---------- Frontend (frontend/.env) ----------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ---------- Backend (backend/.env) ----------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smart-bionote-reader?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Smart Bionote Reader <no-reply@smartbionotereader.com>"
GOOGLE_CLIENT_ID=your_google_client_id_here
