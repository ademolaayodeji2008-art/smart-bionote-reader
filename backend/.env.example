# ─────────────────────────────────────────────────────────────────────────────
# Smart Bionote Reader — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separate multiple origins for staging + production
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smart-bionote-reader?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Media storage for lesson cover images, drawing step images and teacher audio.
# API secret must NEVER be exposed to the frontend.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Email verification + password reset.
# If left unset in development, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Smart Bionote Reader <no-reply@smartbionotereader.com>"

# ── Google Sign-In ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Paystack (Nigerian payment gateway) ───────────────────────────────────────
# Secret key — backend ONLY. Never expose to the frontend.
# Get your keys at https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Public key — safe for use in frontend if needed (e.g. Paystack inline JS)
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# URL Paystack redirects to after payment (your frontend payment result page)
PAYSTACK_CALLBACK_URL=http://localhost:5173/student/payment/result

# ── Production Paystack (switch from test to live for production) ─────────────
# PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key
# PAYSTACK_CALLBACK_URL=https://yourdomain.com/student/payment/result
